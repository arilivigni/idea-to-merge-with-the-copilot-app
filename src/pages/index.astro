---
import Base from '../layouts/Base.astro';
import Bookmarks from '../components/Bookmarks.astro';
---
<Base title="Bookmarks">
  <header>
    <h1>🔖 Bookmarks</h1>
    <p class="tagline">Save a link and get a short, shareable slug — no account needed.</p>
  </header>

  <main>
    <Bookmarks />
  </main>

  <footer>
    Your bookmarks stay on this device, saved in your browser.
  </footer>
</Base>
